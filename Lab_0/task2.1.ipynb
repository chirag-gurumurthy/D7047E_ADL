"""
Task 0.2.1 - Transfer Learning from ImageNet (QUICK DEMO VERSION)
AlexNet on CIFAR-10 - reduced epochs and batch size for faster execution

Experiment A: Fine-tuning (train all layers from scratch on CIFAR-10)
Experiment B: Feature Extraction (pretrained ImageNet weights, features frozen)
"""
import torch
import torch.nn as nn
import torch.optim as optim
from torch.utils.data import DataLoader, Subset
from torchvision import datasets, models, transforms

DEVICE = torch.device("cuda" if torch.cuda.is_available() else "cpu")
BATCH_SIZE = 256  # larger batch for faster training
EPOCHS = 2        # reduced for demo
LR = 1e-3
USE_SUBSET = True  # use only 10% of data for quick demo

# ── Data ──────────────────────────────────────────────────────────────────────
transform = transforms.Compose([
    transforms.Resize(224),
    transforms.ToTensor(),
    transforms.Normalize(mean=[0.485, 0.456, 0.406], std=[0.229, 0.224, 0.225]),
])

train_set = datasets.CIFAR10(root="./data", train=True,  download=True, transform=transform)
test_set  = datasets.CIFAR10(root="./data", train=False, download=True, transform=transform)

if USE_SUBSET:
    # Use only 10% of data for quick demo
    train_indices = list(range(0, len(train_set), 10))
    test_indices  = list(range(0, len(test_set), 10))
    train_set = Subset(train_set, train_indices)
    test_set  = Subset(test_set, test_indices)
    print(f"Using subset: {len(train_set)} train, {len(test_set)} test samples")

train_loader = DataLoader(train_set, batch_size=BATCH_SIZE, shuffle=True,  num_workers=0)
test_loader  = DataLoader(test_set,  batch_size=BATCH_SIZE, shuffle=False, num_workers=0)


# ── Model builder ─────────────────────────────────────────────────────────────
def build_alexnet(pretrained: bool, freeze_features: bool) -> nn.Module:
    weights = models.AlexNet_Weights.DEFAULT if pretrained else None
    model = models.alexnet(weights=weights)

    if freeze_features:
        for param in model.features.parameters():
            param.requires_grad = False
        for param in model.classifier.parameters():
            param.requires_grad = False

    # Append extra FC layer with 10 neurons
    model.classifier = nn.Sequential(
        *model.classifier,
        nn.ReLU(inplace=True),
        nn.Linear(1000, 10),
    )
    return model.to(DEVICE)


# ── Train / Eval ──────────────────────────────────────────────────────────────
def train_epoch(model, loader, optimizer, criterion):
    model.train()
    correct, total = 0, 0
    for images, labels in loader:
        images, labels = images.to(DEVICE), labels.to(DEVICE)
        optimizer.zero_grad()
        outputs = model(images)
        loss = criterion(outputs, labels)
        loss.backward()
        optimizer.step()
        correct += (outputs.argmax(1) == labels).sum().item()
        total += images.size(0)
    return correct / total


def evaluate(model, loader):
    model.eval()
    correct, total = 0, 0
    with torch.no_grad():
        for images, labels in loader:
            images, labels = images.to(DEVICE), labels.to(DEVICE)
            outputs = model(images)
            correct += (outputs.argmax(1) == labels).sum().item()
            total += images.size(0)
    return correct / total


def run_experiment(name: str, pretrained: bool, freeze_features: bool) -> float:
    print(f"\n{'='*60}")
    print(f"  {name}")
    print(f"{'='*60}")

    model = build_alexnet(pretrained=pretrained, freeze_features=freeze_features)
    trainable = sum(p.numel() for p in model.parameters() if p.requires_grad)
    print(f"  Trainable params: {trainable:,}")

    criterion = nn.CrossEntropyLoss()
    optimizer = optim.Adam(filter(lambda p: p.requires_grad, model.parameters()), lr=LR)

    for epoch in range(1, EPOCHS + 1):
        train_acc = train_epoch(model, train_loader, optimizer, criterion)
        test_acc  = evaluate(model, test_loader)
        print(f"  Epoch {epoch}/{EPOCHS} | Train: {train_acc:.4f} | Test: {test_acc:.4f}")

    print(f"  >>> Final Test Accuracy: {test_acc:.4%}")
    return test_acc


# ── Main ──────────────────────────────────────────────────────────────────────
if __name__ == "__main__":
    print(f"Device: {DEVICE}")
    print(f"Quick demo mode: {EPOCHS} epochs, subset={USE_SUBSET}\n")

    acc_a = run_experiment(
        "Experiment A: Fine-tuning (random init)",
        pretrained=False,
        freeze_features=False,
    )

    acc_b = run_experiment(
        "Experiment B: Feature Extraction (pretrained)",
        pretrained=True,
        freeze_features=True,
    )

    print(f"\n{'='*60}")
    print(f"  RESULTS")
    print(f"{'='*60}")
    print(f"  A (Fine-tuning)        : {acc_a:.4%}")
    print(f"  B (Feature Extraction) : {acc_b:.4%}")
    print(f"  Difference             : {abs(acc_b - acc_a):.4%}")
    print("""
  Experiment B typically performs better because ImageNet-pretrained
  features transfer well to CIFAR-10. The model converges faster with
  fewer trainable parameters (only the extra FC layer).
""")
